# Backend only: copy to .env and fill with your Web application OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKALOR_PUBLIC_URL=http://127.0.0.1:8000
BACKALOR_DATA_DIR=backend_data
# Register this exact authorized redirect URI in Google Cloud:
# http://127.0.0.1:8000/auth/google/callback
