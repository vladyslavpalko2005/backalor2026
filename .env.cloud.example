# These variables belong on the cloud server, never on a researcher's computer.
BACKALOR_DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE-HOST:5432/backalor
BACKALOR_REQUIRE_POSTGRES=1
BACKALOR_DATA_DIR=/var/data
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Render automatically supplies RENDER_EXTERNAL_URL. Override for a custom domain:
# BACKALOR_PUBLIC_URL=https://api.example.org
# Free Render + Supabase: keep project ZIPs in PostgreSQL, not an ephemeral disk.
BACKALOR_SNAPSHOT_STORAGE=database
BACKALOR_MAX_UPLOAD_BYTES=20971520
